# =============================================================================
#  Reverse proxy et TLS
#
#  Caddy obtient et renouvelle seul les certificats Let's Encrypt. C'est ce qui
#  evite la panne classique du certificat oublie : sur une flotte, un certificat
#  expire ne coupe pas un site web, il coupe deux mille telephones.
#
#  TROIS noms d'hote, et c'est delibere :
#    - api.<domaine>   : parle aux telephones. Exposition publique obligatoire.
#    - admin.<domaine> : parle aux navigateurs des administrateurs.
#    - algo.<domaine>  : calculateur Trajelys, appele par les navigateurs des
#                        managers. Il n'appartient pas a Phone Control et ne lui
#                        parle pas ; il partage seulement cette machine.
#
#  Les separer permet de restreindre plus tard l'acces au tableau de bord (par
#  adresse IP, par VPN) sans toucher au trafic des telephones, qui vient de
#  n'importe ou sur le reseau mobile.
# =============================================================================
{
	email {$ACME_EMAIL}
	# Journal en JSON : lisible par un agregateur, et surtout parsable le jour
	# ou l'on cherche « quel telephone a echoue a quelle heure ».
	log {
		format json
	}
}

# --- API, appelee par les telephones ------------------------------------------
api.{$PUBLIC_DOMAIN} {
	encode gzip

	# Journal des ACCES.
	#
	# Le bloc `log` global, en tete de ce fichier, ne configure que le journal
	# d'execution : il ne trace aucune requete. L'en-tete de ce fichier promet
	# pourtant de pouvoir chercher « quel telephone a echoue a quelle heure » —
	# c'etait faux, et ca s'est vu au premier provisioning rate, ou l'on ne
	# pouvait meme pas dire si le telephone avait telecharge l'APK.
	#
	# Sur ce nom d'hote seulement : c'est celui des telephones, donc le seul
	# ou la question se pose. Il deviendra bavard avec une grande flotte ; le
	# jour venu, filtrer sur les codes d'erreur plutot que de le couper.
	log {
		format json
	}

	# Depot d'un APK : le corps peut peser cent cinquante mega-octets. La limite
	# par defaut de Caddy le refuserait bien avant que le serveur ne puisse
	# appliquer la sienne.
	request_body {
		max_size 200MB
	}

	# Caddy transmet `X-Forwarded-For` de lui-meme : le declarer ici serait
	# redondant, et il le signale. L'en-tete compte pourtant : sans lui, la
	# limitation de debit compterait toutes les requetes de la flotte sur
	# l'adresse du proxy. Le compteur par jeton (docs/15 §3) couvre le cas
	# authentifie ; l'adresse protege l'enrolement et la connexion, anonymes.
	# --- APK de provisioning, PUBLIC ------------------------------------------
	#
	#  Le telephone telecharge l'application AVANT d'exister pour ce systeme :
	#  au moment du scan, il n'a ni compte, ni jeton, ni entreprise. Ce point
	#  d'entree doit donc etre ouvert, et c'est la seule chose ouverte ici.
	#
	#  La route `/v1/app-packages/:id/download` de l'API ne peut PAS servir a
	#  ca : elle exige `@DeviceAuth()`, c'est-a-dire un telephone deja enrole.
	#  Elle distribue les mises a jour a une flotte existante, ce qui est un
	#  autre probleme.
	#
	#  Ce que ca n'expose pas : l'APK est signe, et l'empreinte du certificat
	#  voyage dans le QR code. Un fichier substitue ici serait refuse par
	#  Android au provisioning. Le rendre public ne donne donc rien d'autre
	#  que l'application elle-meme.
	#
	#  `handle_path` et non `handle` : il retire le prefixe, sans quoi le
	#  fichier serait cherche dans /srv/provisioning/provisioning/.
	handle_path /provisioning/* {
		root * /srv/provisioning
		# `file_server` NU. Le parcours du dossier est deja desactive par
		# defaut, et `browse off` n'est pas une desactivation : l'argument de
		# `browse` est un fichier de GABARIT. Caddy cherchait donc un gabarit
		# nomme « off », ne le trouvait pas, et repondait 500 la ou on
		# attendait 404. Constate sur la machine.
		file_server
	}

	handle {
		reverse_proxy api:3001 {
			# Un lot de synchronisation de cinq cents evenements peut prendre
			# du temps sur un reseau mobile lent.
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# --- Tableau de bord ----------------------------------------------------------
admin.{$PUBLIC_DOMAIN} {
	encode gzip

	# Le depot d'un APK passe aussi par ici : le navigateur envoie le fichier au
	# tableau de bord, qui le relaie a l'API.
	request_body {
		max_size 200MB
	}

	# --- Canal temps reel -----------------------------------------------------
	#
	#  Le flux socket.io vit dans l'API, pas dans le tableau de bord. Le
	#  navigateur l'ouvre pourtant sur CE nom d'hote, et c'est voulu.
	#
	#  L'autre voie — pointer le navigateur sur api.<domaine> — supposait une
	#  variable `NEXT_PUBLIC_REALTIME_URL`. Next.js incorpore ces variables A LA
	#  CONSTRUCTION : posee dans Compose, a l'execution, elle n'atteignait jamais
	#  le navigateur. Le client retombait sur l'origine courante, ou rien
	#  n'ecoutait, et le canal ne s'ouvrait JAMAIS. Constate : zero connexion en
	#  quinze minutes, alors que le telephone envoyait bien ses images.
	#
	#  La corriger en ajoutant un ARG au Dockerfile graverait le domaine dans
	#  l'image, et il faudrait une image par installation. Ici, la meme image
	#  fonctionne partout.
	#
	#  L'authentification passe par un jeton porte dans la poignee de main
	#  socket.io, pas par un cookie : servir ce chemin depuis le meme hote
	#  n'accorde aucun droit supplementaire.
	handle /socket.io/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy dashboard:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}

# --- Calculateur Trajelys -----------------------------------------------------
# Ce service n'est pas Phone Control. Il partage la machine, pas les donnees :
# il s'adresse a Supabase par Internet et ne connait ni le PostgreSQL ni l'API
# d'a cote. Le separer par un nom d'hote permettra de le deplacer ailleurs sans
# toucher au reste.
algo.{$PUBLIC_DOMAIN} {
	encode gzip

	# Un document scanne pour l'OCR peut peser une quinzaine de mega-octets.
	request_body {
		max_size 20MB
	}

	reverse_proxy algo:8000 {
		# Une resolution CP-SAT tient le processeur plusieurs dizaines de
		# secondes, et l'OCR d'un PDF une douzaine. Le delai par defaut de
		# Caddy couperait la reponse avant la fin du calcul, et le manager
		# verrait une erreur reseau sur un travail qui a abouti.
		transport http {
			read_timeout 180s
			write_timeout 180s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
