# URL interne de l'API, utilisee uniquement par le serveur Next.
# Elle n'est jamais exposee au navigateur.
API_INTERNAL_URL=http://localhost:3001/api

# URL publique du flux temps reel (WebSocket), utilisee par le navigateur.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Fond de carte MapLibre. Sans cette valeur, le style de demonstration est
# utilise : contours de pays seulement, inexploitable en production.
# Exemple : https://api.maptiler.com/maps/streets-v2/style.json?key=VOTRE_CLE
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Provisioning des telephones (page /devices/provisioning) ---
# Sans PROVISIONING_SERVER_URL, la page repond « non configure » et n'emet
# aucun jeton. Aucune de ces valeurs n'est exposee au navigateur.

# Adresse PUBLIQUE de l'API : celle que le telephone appellera depuis le reseau
# mobile. Ce n'est PAS API_INTERNAL_URL, qui n'est joignable que du serveur.
PROVISIONING_SERVER_URL=https://api.exemple.fr/api/

# Empreinte du certificat de signature de l'APK, en base64 URL-safe.
# Obtenue par : pcprov checksum --apk app-release.apk
PROVISIONING_SIGNATURE_CHECKSUM=

# URL HTTPS publique ou le telephone telecharge l'APK, AVANT tout enrolement.
PROVISIONING_APK_URL=

# Valeurs par defaut : le paquet et le composant de l'application livree.
# A adapter pour un APK de debug, dont l'identifiant porte le suffixe .debug.
# PROVISIONING_PACKAGE_NAME=com.phonecontrol
# PROVISIONING_ADMIN_COMPONENT=com.phonecontrol/.kiosk.PhoneControlDeviceAdminReceiver

# PROVISIONING_LOCALE=fr_FR
# PROVISIONING_TIMEZONE=Europe/Paris

# Wi-Fi d'atelier. ATTENTION : le mot de passe voyage EN CLAIR dans le QR code.
# Utilisez un reseau dedie au provisioning, isole, dont la cle change apres
# chaque campagne.
# PROVISIONING_WIFI_SSID=ATELIER-FLOTTE
# PROVISIONING_WIFI_SECURITY=WPA
# PROVISIONING_WIFI_PASSWORD=
