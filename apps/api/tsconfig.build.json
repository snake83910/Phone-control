{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    // Ces deux-là ne sont pas livrés : les inclure ferait de `prisma` et de
    // `scripts` des racines de compilation supplémentaires, TypeScript
    // remonterait la racine commune au dossier du paquet, et la sortie
    // deviendrait dist/src/main.js au lieu de dist/main.js — ce qui casse
    // `pnpm start` sans rien dire. Les deux tournent par ts-node.
    //
    // Le dossier ENTIER, jamais fichier par fichier. `prisma/seed.ts` était
    // exclu par son nom ; le jour où `prisma/amorcage.ts` est apparu à côté,
    // l'image s'est construite sans erreur et l'API a redémarré en boucle sur
    // un `dist/main.js` introuvable. Une exclusion nominative ne protège que
    // les fichiers déjà écrits.
    "prisma",
    "scripts"
  ]
}
