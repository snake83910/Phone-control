{
  "name": "@phone-control/api",
  "version": "0.1.0",
  "private": true,
  "description": "API centrale Phone Control (NestJS + Fastify + Prisma)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "ts-node --transpile-only -P tsconfig.json prisma/seed.ts",
    "db:amorcage": "ts-node --transpile-only -P tsconfig.json prisma/amorcage.ts",
    "db:studio": "prisma studio",
    "start:worker": "node dist/worker-main.js",
    "worker:dev": "ts-node --transpile-only -P tsconfig.json src/worker-main.ts",
    "test:recette": "jest --runInBand --verbose -t \"TEST \"",
    "charge": "ts-node --transpile-only -P tsconfig.json scripts/charge.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only -P tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.2.3",
    "@node-rs/argon2": "^2.0.2",
    "@phone-control/provisioning-payload": "workspace:*",
    "@prisma/client": "^6.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^5.11.3",
    "ioredis": "^5.6.0",
    "jose": "^5.10.0",
    "luxon": "^3.5.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.22.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.5.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  }
}
