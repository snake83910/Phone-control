<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      HTTPS uniquement. Aucune exception en production : un telephone qui
      accepte le clair accepte aussi un proxy hostile sur un Wi-Fi de depot.
    -->
    <base-config cleartextTrafficPermitted="false" />

    <!--
      Exception limitee au developpement : 10.0.2.2 est l'hote vu depuis
      l'emulateur Android. Cette section n'existe que dans la variante debug,
      elle est retiree du manifeste de release par la fusion de ressources.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
