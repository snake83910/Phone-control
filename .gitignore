# Dépendances
node_modules/
.pnpm-store/

# Build
dist/
build/
.next/
*.tsbuildinfo

# Secrets — aucun secret ne doit entrer dans Git
.env
.env.*
!.env.example
!.env.prod.example
!.env.local.example

# Tests / couverture
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Android
apps/android/local.properties
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/core-rules/build/
apps/android/.idea/
apps/android/captures/
*.keystore
*.jks

# Outils
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Outillage de provisioning — jetons d'enrolement, QR codes, planches
# Tout ce que produit tools/provisioning contient des secrets a duree limitee.
tools/provisioning/out/
tools/provisioning/**/provisioning.config.json
!tools/provisioning/provisioning.config.example.json

# APK deposes pour deploiement : jamais versionnes.
storage/

# Mots de passe du keystore de release. Le keystore lui-meme est deja
# couvert par *.jks et *.keystore ; ce fichier porte ses mots de passe.
apps/android/keystore.properties
