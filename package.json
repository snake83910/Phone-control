{
  "name": "phone-control",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Gestion et verrouillage de téléphones Android professionnels par badge Code 128",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose down",
    "dev:api": "pnpm --filter @phone-control/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @phone-control/api db:migrate",
    "db:seed": "pnpm --filter @phone-control/api db:seed",
    "db:studio": "pnpm --filter @phone-control/api db:studio",
    "db:reset": "pnpm --filter @phone-control/api db:reset",
    "dev:dashboard": "pnpm --filter @phone-control/dashboard dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
