# =============================================================================
#  Phone Control — variables d'environnement
#  Copier en .env et remplir. Aucun secret réel ne doit être commité.
# =============================================================================

NODE_ENV=development
API_PORT=3001
API_GLOBAL_PREFIX=api
LOG_LEVEL=debug

# --- Infrastructure locale (docker-compose) ---------------------------------
POSTGRES_USER=phonecontrol
POSTGRES_PASSWORD=phonecontrol
POSTGRES_DB=phonecontrol
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- Connexions --------------------------------------------------------------
DATABASE_URL=postgresql://phonecontrol:phonecontrol@localhost:5433/phonecontrol?schema=public
REDIS_URL=redis://localhost:6380

# --- Jetons administrateurs ---------------------------------------------------
# Générer : openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-dev-only-access-secret
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Jetons appareils ---------------------------------------------------------
DEVICE_JWT_SECRET=change-me-dev-only-device-secret
DEVICE_ACCESS_TTL=60m
DEVICE_REFRESH_TTL=30d
ENROLLMENT_TOKEN_TTL_DAYS=7

# Tolérance sur l'horloge des téléphones, en secondes. Au-delà, un événement daté
# dans le futur est accepté mais marqué « clock_suspect », et une alerte est
# levée : les règles horaires du dépôt reposent sur cette horloge.
CLOCK_SKEW_TOLERANCE_SECONDS=300

# --- Notification des alertes ------------------------------------------------
# Les destinataires (webhooks, adresses) sont propres à chaque entreprise et se
# règlent dans Company.settings.notifications. Ici ne vit que le transport.
#
# Relais SMTP, sous forme d'URL. Absent, le canal courriel se déclare non
# configuré et n'essaie rien — mieux qu'un envoi qui échoue à chaque alerte.
SMTP_URL=
SMTP_FROM=phone-control@exemple.fr

# --- Réveil rapide des téléphones (facultatif) -------------------------------
# Clé de compte de service Firebase, en JSON sur une seule ligne. Absente, les
# téléphones sont réveillés par leur sondage périodique : plus lent, mais
# complet. FCM n'est jamais une dépendance.
FCM_SERVICE_ACCOUNT=

# Format attendu d'un numero de badge, en expression reguliere, applique a
# l'enregistrement sur la valeur normalisee (majuscules, sans espaces ni tirets).
# Vide : tout est accepte. Une fois le format du parc connu, le renseigner evite
# qu'une saisie fautive devienne un badge que personne ne pourra scanner et que
# l'on ne saura plus identifier — seuls les quatre derniers caracteres restent
# visibles. Pour un badge numerique a huit chiffres : ^[0-9]{8}$
BADGE_FORMAT_PATTERN=

# --- Badges : protection de la valeur du code-barres --------------------------
# Poivre du HMAC-SHA256 appliqué à la valeur normalisée du badge.
# CRITIQUE : le modifier rend TOUS les badges existants introuvables.
# Générer : openssl rand -hex 32
BADGE_HMAC_PEPPER=change-me-dev-only-badge-pepper
BADGE_HASH_VERSION=1

# Clé maîtresse servant à dériver, par appareil, la clé HMAC utilisée pour
# l'authentification hors ligne (HKDF). Générer : openssl rand -hex 32
DEVICE_MASTER_KEY=change-me-dev-only-device-master-key

# Clé AES-256-GCM optionnelle pour le stockage réversible du numéro de badge.
# Laisser vide désactive la fonctionnalité (recommandé par défaut).
BADGE_ENCRYPTION_KEY=

# --- Limitation de débit ------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
BARCODE_THROTTLE_PER_DEVICE_PER_MIN=10
BARCODE_THROTTLE_PER_BADGE_PER_MIN=5
BARCODE_DEVICE_LOCKOUT_FAILURES=30
BARCODE_DEVICE_LOCKOUT_MINUTES=15

# --- Dashboard ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# --- Tâches planifiées ---------------------------------------------------------
# true : l'API exécute aussi le verrouillage 22h, la surveillance et la purge.
# false : à utiliser sur les répliques d'API quand un worker dédié tourne.
WORKER_ENABLED=true

# --- Notifications (Phase 7) ---------------------------------------------------
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=

# --- Amorçage (seed) -----------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@phone-control.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026

# --- Partage d'ecran avec accord du chauffeur --------------------------------
# Delai laisse au chauffeur pour repondre a une demande. Passe ce delai, la
# demande expire d'elle-meme, plutot que de surgir plus tard devant quelqu'un
# qui roule depuis.
SCREEN_SHARE_RESPONSE_TIMEOUT_SECONDS=120
# Duree maximale d'un partage accorde. La seance se ferme SEULE, sans que
# personne n'ait a y penser : c'est la garantie qui distingue une assistance
# d'une surveillance.
SCREEN_SHARE_MAX_DURATION_SECONDS=600
# Bornes techniques du flux d'images. Aucune image n'est conservee : elles sont
# relayees a l'administrateur demandeur, puis oubliees.
SCREEN_SHARE_MAX_FRAME_BYTES=400000
SCREEN_SHARE_MIN_FRAME_INTERVAL_MS=700

# --- Deploiement d'applications ----------------------------------------------
# Repertoire ou sont conserves les APK deposes. Hors du depot de sources, et
# hors de tout repertoire servi statiquement : un APK ne se telecharge qu'avec
# le jeton d'un appareil enrole.
APP_PACKAGE_STORAGE_DIR=./storage/app-packages
# Taille maximale d'un APK accepte, en octets. Le flux est coupe des que la
# borne est franchie : le fichier n'est jamais entierement recu avant d'etre
# refuse.
APP_PACKAGE_MAX_BYTES=157286400
