{
  "name": "@phone-control/provisioning",
  "version": "0.1.0",
  "private": true,
  "description": "Outillage d'atelier : jetons d'enrôlement, QR codes de provisioning Device Owner, planches à imprimer",
  "bin": {
    "pcprov": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pcprov": "ts-node --transpile-only -P tsconfig.json src/cli.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@phone-control/provisioning-payload": "workspace:*",
    "pdfkit": "^0.15.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.13.9",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.22.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  }
}
