# =============================================================================
#  Phone Control — production
#
#  Copier en `.env.prod` SUR LE SERVEUR, jamais dans le depot de sources.
#  Generer les secrets avec :  ./deploy/generer-secrets.sh
#
#  Trois de ces valeurs ne se regenerent pas :
#
#    BADGE_HMAC_PEPPER   — le changer rend TOUS les badges introuvables.
#    DEVICE_MASTER_KEY   — le changer casse l'authentification hors ligne.
#    BADGE_ENCRYPTION_KEY— le changer rend les valeurs chiffrees illisibles.
#
#  Elles doivent etre sauvegardees AILLEURS que sur le VPS, et separement de la
#  base : une sauvegarde de base sans le poivre ne permet de restaurer aucun
#  badge. C'est le point de defaillance le plus discret de toute l'installation.
# =============================================================================

NODE_ENV=production
API_PORT=3001
API_GLOBAL_PREFIX=api
LOG_LEVEL=info

# --- Noms d'hote --------------------------------------------------------------
# Deux sous-domaines a faire pointer vers l'adresse IPv4 du VPS :
#   api.<domaine>    -> les telephones
#   admin.<domaine>  -> les navigateurs
PUBLIC_DOMAIN=exemple.fr
ACME_EMAIL=exploitation@exemple.fr

# --- Base de donnees ----------------------------------------------------------
POSTGRES_USER=phonecontrol
POSTGRES_PASSWORD=
POSTGRES_DB=phonecontrol
# `postgres` est le nom du service dans docker-compose, pas une machine
# publique : la base n'est joignable que depuis le reseau des conteneurs.
DATABASE_URL=postgresql://phonecontrol:MOT_DE_PASSE@postgres:5432/phonecontrol?schema=public

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://:MOT_DE_PASSE@redis:6379

# --- Jetons administrateurs ---------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Jetons appareils ---------------------------------------------------------
DEVICE_JWT_SECRET=
DEVICE_ACCESS_TTL=60m
DEVICE_REFRESH_TTL=30d
ENROLLMENT_TOKEN_TTL_DAYS=7
CLOCK_SKEW_TOLERANCE_SECONDS=300

# --- Badges : IRREMPLACABLES (voir en-tete) -----------------------------------
BADGE_HMAC_PEPPER=
BADGE_HASH_VERSION=1
DEVICE_MASTER_KEY=
# Vide = pas d'authentification hors ligne par valeur chiffree. Recommande tant
# que le besoin n'est pas etabli : une donnee qu'on ne stocke pas ne fuit pas.
BADGE_ENCRYPTION_KEY=

# Format des badges du parc. Le renseigner des qu'il est connu : sans lui, une
# saisie fautive devient un badge que personne ne pourra scanner et que l'on ne
# saura plus identifier. Huit chiffres : ^[0-9]{8}$
BADGE_FORMAT_PATTERN=

# --- Limitation de debit ------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
BARCODE_THROTTLE_PER_DEVICE_PER_MIN=10
BARCODE_THROTTLE_PER_BADGE_PER_MIN=5
BARCODE_DEVICE_LOCKOUT_FAILURES=30
BARCODE_DEVICE_LOCKOUT_MINUTES=15

# --- Tableau de bord ----------------------------------------------------------
CORS_ORIGINS=https://admin.exemple.fr
DASHBOARD_URL=https://admin.exemple.fr

# --- Taches planifiees --------------------------------------------------------
# Laisse a false ici : c'est le service `worker` qui les execute. Le fichier est
# partage par les deux, et docker-compose surcharge cette valeur pour le worker.
WORKER_ENABLED=false

# --- Notifications ------------------------------------------------------------
SMTP_URL=
SMTP_FROM=phone-control@exemple.fr
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT=

# --- Partage d'ecran ----------------------------------------------------------
SCREEN_SHARE_RESPONSE_TIMEOUT_SECONDS=120
SCREEN_SHARE_MAX_DURATION_SECONDS=600
SCREEN_SHARE_MAX_FRAME_BYTES=400000
SCREEN_SHARE_MIN_FRAME_INTERVAL_MS=700

# --- Deploiement d'applications -----------------------------------------------
# Surcharge par docker-compose vers le volume persistant. Ne pas y toucher.
APP_PACKAGE_STORAGE_DIR=/app/storage/app-packages
APP_PACKAGE_MAX_BYTES=157286400

# --- Amorçage -----------------------------------------------------------------
# Utilise UNE FOIS, a la premiere mise en service. Changer le mot de passe des
# la premiere connexion, puis vider ces deux lignes.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# =============================================================================
#  Calculateur Trajelys (service `algo`)
#
#  Ce service partage la machine avec Phone Control mais n'a AUCUN lien avec
#  lui : il s'adresse a Supabase par Internet. Il est ici parce que ses besoins
#  sont complementaires — Phone Control est limite par la memoire et n'utilise
#  que deux coeurs sur douze, CP-SAT est du calcul pur qui prendrait tout ce
#  qu'on lui laisse. Sa limite a six coeurs garantit qu'il en reste six.
#
#  Supprimer ce bloc et le service `algo` du Compose n'affecte pas Phone
#  Control.
# =============================================================================

# Etiquette a deployer. Mettre un SHA au lieu de `latest` pour revenir en
# arriere : `latest` ne permet pas de dire quelle version tourne.
ALGO_IMAGE=ghcr.io/snake83910/trajelys-algo:latest

# Origines autorisees a appeler le calculateur depuis un navigateur, separees
# par des virgules. Sans la bonne valeur, le site de Trajelys se fait refuser
# avec pour seul indice une erreur CORS dans la console.
CORS_ORIGINES=https://planning-dsp.vercel.app

# Acces Supabase de Trajelys. La cle de service contourne les RLS : elle ne doit
# exister que sur ce serveur, et jamais dans le depot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
